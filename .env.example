# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-supabase
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-uniquement-cote-serveur

# Clé de chiffrement AES-256 (64 caractères hexadécimaux, uniquement côté serveur)
ENCRYPTION_SECRET_KEY=generez-une-cle-aleatoire-de-64-caracteres-hexadecimaux

# Le MVP de test reste local et n'accepte que des données fictives.
NEXT_PUBLIC_DEMO_MODE=true
